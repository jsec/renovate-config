{
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all",
    "schedule:monthly"
  ],
  "lockFileMaintenance": {
    "commitMessageAction": "update lockfile",
    "extends": [
      "group:all"
    ]
  },
  "separateMajorMinor": true
}
