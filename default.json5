{
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixChore",
    ":ignoreModulesAndTests",
    ":disablePeerDependencies",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all",
    "helpers:disableTypesNodeMajor",
    "helpers:pinGitHubActionDigests",
    "schedule:monthly"
  ],
  "baseBranches": ["develop"],
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "postUpdateOptions": ["npmDedupe", "pnpmDedupe", "yarnDedupeFewer"],
  "separateMajorMinor": true,
  "lockFileMaintenance": {
    "commitMessageAction": "lockfile maintenance",
    "extends": [
      "group:all"
    ]
  }
}
