{
  "extends": [
    "config:recommended", 
    "helpers:pinGitHubActionDigests",
    "schedule:monthly"
  ],
  "prConcurrentLimit": 5,
  "ignoreDeps": [
    "pnpm",
    "@types/node"
  ],
  "semanticCommitType": "chore",
  "major": false,
  "labels": ["bot: dependencies"],
  "packageRules": [
    {
      "packageNames": ["actions/*"],
      "groupName": "all actions",
      "groupSlug": "github-actions"
    },
    {
      "matchPackagePatterns": [
        "prettier",
        "eslint-*",
        "eslint",
        "stylelint",
        "@typescript-eslint/*"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "linting dependencies",
      "groupSlug": "linting"
    },
    {
      "matchPackagePatterns": [
        "supertest", 
        "nock", 
        "mocha", 
        "chai",
        "sinon",
        "vitest"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "test dependencies",
      "groupSlug": "test"
    },
    {
      "matchPackagePatterns": ["@types/*", "typescript", "tsx"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "typescript dependencies",
      "groupSlug": "types"
    }
  ],
  "pinVersions": false
}
