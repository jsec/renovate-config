{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticPrefixChore",
        "replacements:all",
        "workarounds:all",
        "helpers:disableTypesNodeMajor",
        "helpers:pinGitHubActionDigests",
        "schedule:weekends"
    ],
    "baseBranchPatterns": ["develop"],
    "rebaseWhen": "conflicted",
    "labels": ["dependencies"],
    "rangeStrategy": "bump",
    "postUpdateOptions": [
        "npmDedupe", 
        "pnpmDedupe", 
        "yarnDedupeFewer"
    ],
    "separateMajorMinor": true,
    "lockFileMaintenance": {
        "commitMessageAction": "lockfile maintenance",
        "extends": [
          "group:all"
        ]
    },
    "vulnerabilityAlerts": {
        "enabled": false
    },
    "packageRules": [
        {
            "groupName": "database tools",
            "matchPackageNames": [
                "pg",
                "drizzle-orm",
                "drizzle-kit",
                "kysely",
                "kysely-codegen",
                "@types/pg"
            ]
        },
        {
            "groupName": "Tanstack",
            "matchPackageNames": [
                "@tanstack/react-query",
                "@tanstack/react-query-devtools",
                "@tanstack/devtools-vite",
                "@tanstack/react-devtools"
            ]
        },
        {
            "groupName": "Eslint",
            "matchPackageNames": [
                "eslint",
                "typescript-eslint",
                "@jarsec/eslint-config"
            ]
        },
        {
            "groupName": "Biome",
            "matchPackageNames": [
                "@biomejs/biome",
                "@jarsec/biome-config"
            ]
        },
        {
            "groupName": "oxc tools",
            "matchPackageNames": [
                "oxlint",
                "@jarsec/oxlint-config",
                "oxfmt"
            ]
        },
        {
            "groupName": "TypeScript tooling",
            "matchPackageNames": [
                "tsx",
                "tsdown",
                "@jarsec/tsconfig"
            ]
        },
        {
            "groupName": "Tailwind",
            "matchPackageNames": [
                "@tailwindcss/vite",
                "tailwindcss",
                "tw-animate-css"
            ]
        },
        {
            "groupName": "React",
            "matchPackageNames": [
                "react",
                "react-dom",
                "@types/react",
                "@types/react-dom"
            ]
        },
        {
            "groupName": "Hono",
            "matchPackageNames": [
                "hono",
                "@hono/node-server"
            ]
        }
    ]
}
