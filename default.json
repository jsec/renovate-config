{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticPrefixChore",
        "replacements:all",
        "workarounds:all",
        "helpers:disableTypesNodeMajor",
        "helpers:pinGitHubActionDigests",
        "schedule:weekends"
    ],
    "baseBranchPatterns": ["develop"],
    "rebaseWhen": "conflicted",
    "labels": ["dependencies"],
    "rangeStrategy": "bump",
    "postUpdateOptions": [
        "npmDedupe", 
        "pnpmDedupe", 
        "yarnDedupeFewer"
    ],
    "separateMajorMinor": true,
    "lockFileMaintenance": {
        "commitMessageAction": "lockfile maintenance",
        "extends": [
          "group:all"
        ]
    },
    "vulnerabilityAlerts": {
        "enabled": false
    },
    "packageRules": [
        {
            "groupName": "database",
            "matchPackageNames": [
                "pg",
                "drizzle-orm",
                "drizzle-kit",
                "kysely",
                "kysely-codegen",
                "@types/pg"
            ]
        },
        {
            "groupName": "tanstack",
            "matchPackageNames": [
                "@tanstack/react-query",
                "@tanstack/react-query-devtools",
                "@tanstack/devtools-vite",
                "@tanstack/react-devtools"
            ]
        },
        {
            "groupName": "linting",
            "matchPackageNames": [
                "prettier",
                "eslint",
                "oxlint",
                "@biomejs/biome",
                "@jarsec/eslint-config",
                "@jarsec/biome-config",
                "@jarsec/oxlint-config"
            ]
        },
        {
            "groupName": "lint plugins",
            "matchPackageNames": [
                "eslint-plugin-n",
                "eslint-plugin-react",
                "eslint-plugin-react-hooks",
                "eslint-plugin-unicorn",
                "eslint-plugin-react-hooks",
                "eslint-plugin-perfectionist",
                "@stylistic/eslint-plugin"
            ]
        },
        {
            "groupName": "typescript",
            "matchPackageNames": [
                "typescript",
                "typescript-eslint"
            ]
        },
        {
            "groupName": "typescript tooling",
            "matchPackageNames": [
                "tsx",
                "tsdown",
                "@jarsec/tsconfig"
            ]
        },
        {
            "groupName": "tailwind",
            "matchPackageNames": [
                "@tailwindcss/vite",
                "tailwindcss",
                "tw-animate-css"
            ]
        },
        {
            "groupName": "react",
            "matchPackageNames": [
                "react",
                "react-dom",
                "@types/react",
                "@types/react-dom"
            ]
        }
    ]
}
